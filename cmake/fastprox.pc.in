prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: fastprox
Description: Exact proximal operators and projections with derivatives
Version: @FASTPROX_VERSION_FULL@
Libs: -L${libdir} -lfastprox
Libs.private: @CMAKE_THREAD_LIBS_INIT@
Cflags: -I${includedir}
